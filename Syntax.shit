create function called hello using string name, string age {
    call talk with "Hello " + name + "! You are " + age + " years old!"
}

create number called loop
set loop to 0

repeat 5 times {
    set loop to loop + 1
    call hello with "Eddie", loop
}

create string called input
set input to call takeInput

create number called repeatTimes
set repeatTimes to call toNumber with input

repeat repeatTimes times {
    call talk with "time"
}